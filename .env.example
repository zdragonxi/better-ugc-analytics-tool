# Copy to .env (next to config.ini) or set these in your environment / docker-compose.
# Real environment variables override .env, and both override config.ini.
# .env is git-ignored — never commit it.

# Your .ROBLOSECURITY cookie value. Prefer RSA_COOKIE_FILE pointing at a chmod-600 file;
# an environment variable can be visible to other processes run by the same user.
# RSA_COOKIE=
RSA_COOKIE_FILE=roblox_cookie.txt

# Groups as id:name pairs (alternative to [group:<id>] sections in config.ini)
# RSA_GROUPS=1111111:My First Group,2222222:Another Group

# RSA_CONFIG=config.ini
# RSA_HOST=127.0.0.1
# RSA_PORT=8930
# RSA_DB_PATH=data/sales.db
# RSA_PROXY=http://user:pass@proxy.example:3128
# RSA_PASSWORD_HASH=
# RSA_ALLOWED_HOSTS=
# RSA_TRACK_USER_SALES=true
# RSA_USER_STORE_NAME=My account
# RSA_SYNC_INTERVAL=180
# RSA_FINANCIALS_INTERVAL=120
# RSA_BALANCE_INTERVAL=120
# RSA_INITIAL_SYNC_DAYS=90
# RSA_CATALOG_INTERVAL=600
# RSA_ASSET_TYPES=8,41,42,43,44,45,46,47,64,65,66,67,68,69,70,71,72
